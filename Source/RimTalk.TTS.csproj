<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
        <OutputType>Library</OutputType>
        <TargetFramework>net48</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <RootNamespace>RimTalk.TTS</RootNamespace>
        <AssemblyName>RimTalk.TTS</AssemblyName>
        <Version>2.0.0</Version>
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0.0</FileVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(RIMWORLD_DIR)</RimWorldDir>

        <OutputPath>../1.6/Assemblies</OutputPath>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <!-- Define version constants based on GameVersion -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>
    </PropertyGroup>

    <!-- Release build configuration -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <Optimize>false</Optimize>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <!-- Core RimWorld & UnityEngine libraries -->
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
        <!-- Harmony API -->
        <PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All"/>
    </ItemGroup>

    <!-- Reference to the RimTalk mod assembly for compilation (provided by the game/mod at runtime).
         Defaults to the released Workshop 1.4.4 build, which is the API players actually run.
         Override with -p:RimTalkAssembly=<path> to compile against another RimTalk build. -->
    <PropertyGroup>
        <WorkshopRimTalk>D:\steam\steamapps\workshop\content\294100\3551203752\1.6\Assemblies\RimTalk.dll</WorkshopRimTalk>
        <DevRimTalk>D:\steam\steamapps\common\RimWorld\Mods\rimtalk\1.6\Assemblies\RimTalk.dll</DevRimTalk>
        <RimTalkAssembly Condition=" '$(RimTalkAssembly)' == '' and Exists('$(WorkshopRimTalk)') ">$(WorkshopRimTalk)</RimTalkAssembly>
        <RimTalkAssembly Condition=" '$(RimTalkAssembly)' == '' ">$(DevRimTalk)</RimTalkAssembly>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="RimTalk">
            <HintPath>$(RimTalkAssembly)</HintPath>
            <!-- Do not copy the assembly into our output; the game loads mod assemblies from its folder. -->
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
